# Copy to .env.local for local development. On Vercel, set these in
# Project → Settings → Environment Variables (Production and Preview).

# Upstash Redis (added automatically when you connect Upstash Redis in Vercel → Storage).
# Either naming works.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Vercel Blob, for the résumé PDF. Connecting a private Blob store to the project
# adds these automatically; on Vercel the SDK signs in with the deployment's OIDC
# token, so there's no read-write token. Résumé upload doesn't work locally.
BLOB_STORE_ID=
BLOB_WEBHOOK_PUBLIC_KEY=

# Admin at /admin. Make these with `pnpm admin:secrets` and `pnpm admin:hash`.
# ADMIN_SESSION_SECRET: signs the admin cookie (32+ characters).
ADMIN_SESSION_SECRET=
# ADMIN_PASSWORD_HASH: scrypt hash of the sign-in password. Never the password itself.
ADMIN_PASSWORD_HASH=
# ADMIN_SAVE_PASSWORD_HASH: scrypt hash of the second password, asked before changes are saved.
ADMIN_SAVE_PASSWORD_HASH=

# Public address of the site, used in the sitemap. Optional on Vercel.
# NEXT_PUBLIC_SITE_URL=https://example.com

# Dev only: keep site content in .data/site.json instead of Redis, and keep admin
# sessions and rate limits in memory. Ignored in production builds.
# SITE_STORE=file
